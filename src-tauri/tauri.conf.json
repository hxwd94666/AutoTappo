{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoTappo",
  "version": "0.1.0",
  "identifier": "com.autotappo.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "native/autotappo_hook/target/release/autotappo_hook.dll": "autotappo_hook.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
